# ==============================================================
# GymZ AI - Vercel Environment Variables
# Add these in Vercel Dashboard -> Project Settings -> Environment Variables
# ==============================================================

# Recipient email where contact & waitlist submissions are delivered:
CONTACT_RECEIVER_EMAIL=gymzai@rasinnovatech.com

# --------------------------------------------------------------
# SUPABASE (Required for Beta Waitlist & Contact DB logging)
# Server-only! Never expose SUPABASE_SERVICE_ROLE_KEY in HTML/JS.
# --------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_or_secret_key

# --------------------------------------------------------------
# OPTION 1: Resend (Recommended & Easiest for Vercel)
# 1. Sign up for free at https://resend.com
# 2. Generate an API Key (e.g. re_xxxx...)
# 3. Add RESEND_API_KEY to your Vercel Environment Variables
# --------------------------------------------------------------
RESEND_API_KEY=resend api key
EMAIL_FROM=GymZ AI <gymzai@rasinnovatech.com>

# --------------------------------------------------------------
# OPTION 2: Standard SMTP (Gmail, Google Workspace, Zoho, etc.)
# --------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_specific_password

# --------------------------------------------------------------
# OPTION 3: Web3Forms (Zero-backend setup)
# --------------------------------------------------------------
# WEB3FORMS_ACCESS_KEY=your_access_key_here

